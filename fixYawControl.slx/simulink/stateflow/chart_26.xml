      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [rotX, rotY, rotZ] = quatToEuler(Q)
% Q = [q0 q1 q2 q3], scalar first

q0 = Q(1);
q1 = Q(2);
q2 = Q(3);
q3 = Q(4);

rotY = atan2(2*(q0*q1 + q2*q3), ...
    1 - 2*(q1^2 + q2^2));

s = 2*(q0*q2 - q3*q1);
s = max(-1, min(1, s));
rotX = asin(s);

rotZ = atan2(2*(q0*q3 + q1*q2), ...
    1 - 2*(q2^2 + q3^2));
end

</P>
      </eml>
    </state>
